# Postgres connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full"

# JWT: use long random strings, and different ones for access and refresh tokens
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=3000

# Comma-separated frontend origins allowed to call the API
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"

# AI tag suggestions (server-side only; never put this key in the frontend).
# Create a key at https://platform.openai.com/api-keys. Leave it empty to disable the feature (the endpoint returns 503).
OPENAI_API_KEY=""
# Any chat model that supports Structured Outputs (json_schema)
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"
AI_TIMEOUT_MS=30000
# Let the AI look at image/logo assets (public https PNG, JPEG, WEBP or GIF). "false" uses only the text details.
AI_VISION=true
# Image detail: low (cheapest), high (reads small text better) or auto
AI_IMAGE_DETAIL="low"
